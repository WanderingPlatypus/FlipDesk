{
  "manifest_version": 3,
  "name": "FlipDesk Sync",
  "version": "1.1.0",
  "description": "Envoie automatiquement tes annonces, ventes et achats Vinted et Leboncoin vers ton serveur FlipDesk.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "tabs", "notifications"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.vinted.fr/*"], "js": ["vinted.js"], "run_at": "document_idle" },
    { "matches": ["https://www.leboncoin.fr/*"], "js": ["lbc.js"], "run_at": "document_start" }
  ],
  "web_accessible_resources": [
    { "resources": ["lbc-hook.js"], "matches": ["https://www.leboncoin.fr/*"] }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlipDesk",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
